{
  "credit": "Combat Writing — Learning Producers Inc., Israel Hernandez, founder",
  "note": "Provider entries for the Combat Writing crew add-on. Each entry names an address, the key it needs (a prompt value first, an environment variable when the prompt is empty, never a file), the maker map for the ids its catalog returns, the seats it offers as model families (a pattern and a preference, never a pinned id), and its call budget. No model id is written here.",
  "makers": {
    "openai": "OpenAI",
    "qwen": "Alibaba",
    "meta": "Meta",
    "meta-llama": "Meta",
    "llama": "Meta",
    "mistralai": "Mistral AI",
    "mistral": "Mistral AI",
    "google": "Google",
    "gemini": "Google",
    "moonshotai": "Moonshot AI",
    "deepseek": "DeepSeek",
    "x-ai": "xAI",
    "xai": "xAI",
    "grok": "xAI",
    "perplexity": "Perplexity",
    "sonar": "Perplexity",
    "anthropic": "Anthropic",
    "gpt": "OpenAI",
    "o1": "OpenAI",
    "o3": "OpenAI",
    "o4": "OpenAI"
  },
  "providers": [
    {
      "id": "groq",
      "name": "Groq",
      "api": "openai-chat",
      "base_url": "https://api.groq.com/openai/v1",
      "key_prompt_env": "CW_CREW_GROQ_KEY",
      "key_env": "GROQ_API_KEY",
      "catalog": {
        "exclude": "whisper|orpheus|tts|guard|compound|safeguard|embed",
        "min_context": 32768,
        "min_output": 4096
      },
      "seats": [
        { "slot": "groq-a", "family": "OpenAI's open-weight line", "vendor": "openai", "match": "^openai/gpt-oss-\\d+b$", "prefer": "largest" },
        { "slot": "groq-b", "family": "Alibaba's Qwen line", "vendor": "qwen", "match": "^qwen/", "prefer": "newest" }
      ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 },
      "request_extras": { "openai": { "reasoning_effort": "low", "reasoning_format": "hidden" }, "qwen": { "reasoning_effort": "none", "reasoning_format": "hidden" } }
    },
    {
      "id": "xai",
      "name": "xAI",
      "api": "openai-chat",
      "base_url": "https://api.x.ai/v1",
      "key_prompt_env": "CW_CREW_XAI_KEY",
      "key_env": "XAI_API_KEY",
      "seats": [ { "slot": "xai", "family": "xAI's Grok line", "vendor": "grok", "match": "^grok-", "prefer": "newest" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    },
    {
      "id": "perplexity",
      "name": "Perplexity",
      "api": "openai-chat",
      "base_url": "https://api.perplexity.ai",
      "key_prompt_env": "CW_CREW_PERPLEXITY_KEY",
      "key_env": "PERPLEXITY_API_KEY",
      "seats": [ { "slot": "perplexity", "family": "Perplexity's Sonar line", "vendor": "sonar", "match": "^sonar", "prefer": "newest" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "api": "openai-chat",
      "base_url": "https://api.openai.com/v1",
      "key_prompt_env": "CW_CREW_OPENAI_KEY",
      "key_env": "OPENAI_API_KEY",
      "seats": [ { "slot": "openai", "family": "OpenAI's GPT line", "vendor": "gpt", "match": "^gpt-\\d", "prefer": "newest" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    },
    {
      "id": "mistral",
      "name": "Mistral AI",
      "api": "openai-chat",
      "base_url": "https://api.mistral.ai/v1",
      "key_prompt_env": "CW_CREW_MISTRAL_KEY",
      "key_env": "MISTRAL_API_KEY",
      "seats": [ { "slot": "mistral", "family": "Mistral's large line", "vendor": "mistral", "match": "^mistral-(large|medium)", "prefer": "newest" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    },
    {
      "id": "gemini",
      "name": "Google",
      "api": "openai-chat",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "key_prompt_env": "CW_CREW_GEMINI_KEY",
      "key_env": "GEMINI_API_KEY",
      "seats": [ { "slot": "gemini", "family": "Google's Gemini line", "vendor": "gemini", "match": "gemini-", "prefer": "newest" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    },
    {
      "id": "ollama",
      "name": "Ollama (local)",
      "api": "openai-chat",
      "base_url": "http://localhost:11434/v1",
      "key_prompt_env": "",
      "key_env": "",
      "keyless": true,
      "model_prompt_env": "CW_CREW_OLLAMA_MODEL",
      "model_env": "OLLAMA_MODEL",
      "seats": [ { "slot": "ollama", "family": "the local model the person names", "vendor": "", "match": "", "prefer": "named" } ],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 60 }
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "api": "anthropic-messages",
      "base_url": "https://api.anthropic.com/v1",
      "key_prompt_env": "CW_CREW_ANTHROPIC_KEY",
      "key_env": "ANTHROPIC_API_KEY",
      "stub": "Claude's seat is the fresh reader inside the listed plugin, which needs no key. An API-key Anthropic seat would use the Messages API, a different shape from OpenAI-compatible chat; this entry is a stub and crew_list reports it as not built.",
      "seats": [],
      "budget": { "tpm_ceiling": 7700, "hard_cap": 8000, "floor": 1200, "ceiling": 2800, "rpm": 30 }
    }
  ]
}
